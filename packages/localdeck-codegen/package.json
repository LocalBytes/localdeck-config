{
  "name": "@localbytes/localdeck-codegen",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "make": "pnpm run prepare && pnpm run make:test && pnpm run make:prod",
    "make:prod": "node ./dist/esphome-localdeck-stock.mjs > ./esphome-localdeck.yaml && esphome compile ./esphome-localdeck.yaml",
    "make:test": "node ./dist/esphome-localdeck-test.mjs > ./esphome-localdeck-test.yaml && esphome compile ./esphome-localdeck-test.yaml",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "author": "",
  "private": true,
  "license": "ISC",
  "dependencies": {
    "esphome-config-ts": "github:LocalBytes/esphome-config-ts",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "typescript": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "tsdown": "^0.22.14",
    "typescript-eslint": "^8.59.3"
  },
  "exports": {
    "./esphome-localdeck": "./dist/esphome-localdeck.mjs",
    "./esphome-localdeck-stock": "./dist/esphome-localdeck-stock.mjs",
    "./esphome-localdeck-test": "./dist/esphome-localdeck-test.mjs",
    "./scripts/apply-rgb-color": "./dist/scripts/apply-rgb-color.mjs",
    "./scripts/blip-light": "./dist/scripts/blip-light.mjs",
    "./virtuals/configured-button": "./dist/virtuals/configured-button.mjs",
    "./virtuals/slider-number": "./dist/virtuals/slider-number.mjs",
    "./package.json": "./package.json"
  }
}
