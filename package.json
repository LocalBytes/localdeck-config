{
  "name": "localdeck-config",
  "private": true,
  "scripts": {
    "build": "pnpm run -r build",
    "build:configurator": "pnpm --filter=localdeck-configurator build",
    "configurator": "just configurator",
    "lint": "pnpm run --no-bail --parallel -r lint",
    "lint:fix": "pnpm run --no-bail --parallel -r lint:fix",
    "test": "pnpm run --no-bail --parallel -r test",
    "dev": "pnpm run --parallel -w \"/^dev:.*/\"",
    "dev:configurator": "pnpm --filter=localdeck-configurator dev",
    "dev:codegen": "pnpm --filter=localdeck-codegen dev"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.2",
    "@vue/language-server": "^3.3.11",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "shx": "^0.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "nuxt": "catalog:"
  }
}
